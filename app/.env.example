# Server-only. The browser calls Next.js; Next.js calls FastAPI.
# On Vercel this is the Render API origin, with no trailing slash.
# Do not put DATABASE_URL here.
API_URL=http://127.0.0.1:8000
# Public Google OAuth Web client ID. The API checks the same value as GOOGLE_CLIENT_ID.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
