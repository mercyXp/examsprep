# FastAPI origin, no trailing slash.
# Web preview on this computer:
EXPO_PUBLIC_API_URL=http://localhost:8000
# Android emulator (the computer running uvicorn):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Optional. Same Web client id as GOOGLE_CLIENT_ID on the API.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Pollar publishable key from https://dashboard.pollar.xyz
# It is a publishable key (pub_testnet_... or the live key), not a secret key.
# Leave it unset to show the not-configured rewards state. Do not commit a real key.
# EXPO_PUBLIC_POLLAR_PUBLISHABLE_KEY=
