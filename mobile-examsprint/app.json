{
  "expo": {
    "name": "ExamSprint",
    "slug": "examsprint",
    "scheme": "examsprint",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "android": {
      "package": "xyz.examsprep.examsprint",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07111F"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": ["expo-router", "expo-web-browser", "expo-status-bar", "expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    }
  }
}
