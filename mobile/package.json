{
  "name": "mobile",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run android:build",
    "dev": "expo start --clear --dev-client --reset-cache",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "start": "expo start",
    "web": "expo start --web"
  },
  "displayName": "ExamsPrep",
  "description": "ExamsPrep Android app. Email and Google sign-in against FastAPI, plus Mobile Wallet Adapter for Solana badges and prize pools.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "solana-kit",
    "tailwind",
    "uniwind",
    "wallet",
    "wallet-ui"
  ],
  "main": "./index.js",
  "version": "0.0.0",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@nanostores/react": "^1.1.0",
    "@solana-mobile/skr-domain": "^1.1.1",
    "@solana-mobile/skr-genesis-token": "^1.0.1",
    "@solana-program/memo": "^0.15.0",
    "@solana/kit": "^8.5.0",
    "@solana/kit-plugin-rpc": "^0.19.0",
    "@tanstack/react-query": "^5.100.14",
    "@wallet-ui/react-native-kit": "^4.4.1",
    "expo": "~58.0.20",
    "expo-auth-session": "~58.0.20",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-font": "~58.0.10",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.1.0",
    "heroui-native": "^1.0.3",
    "nanostores": "^1.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^4.3.1",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "~4.1.16",
    "uniwind": "^1.7.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "private": true
}
