# Windows PostgreSQL + pgAdmin: user is usually postgres.
# Password is the one you chose in the installer. If it contains @ # : / encode it in the URL.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/examsprep
SECRET_KEY=dev-only-change-me-please-use-a-long-local-secret
SEED_DEMO_USERS=true

# Railway: use the provider DATABASE_URL, then rewrite the scheme to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
