# Windows PostgreSQL + pgAdmin: user is usually postgres.
# Password is the one you chose in the installer. If it contains @ # : / encode it in the URL.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/examsprep
SECRET_KEY=dev-only-change-me-please-use-a-long-local-secret
SEED_DEMO_USERS=true
# One-time production super administrator on the API host. Leave unset locally.
# Set all three, redeploy, then delete them. See docs/operations/deployment.md.
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# Public site origin used in invitation and password-reset links. No trailing slash.
# FRONTEND_URL=http://localhost:3000
# APP_URL is only a fallback when FRONTEND_URL is unset.
# Resend. Leave the key unset locally to skip sending. The Staff page then shows the invitation link once.
# RESEND_API_KEY=
# EMAIL_FROM=ExamsPrep <invites@examsprep.xyz>
# Optional local folder for lesson media uploads (default: api/var/media)
# MEDIA_ROOT=var/media

# Optional lesson-studio drafts. auto uses the key when it is set, and a local draft when it is not.
# AI_PROVIDER=auto
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Render: use the provider DATABASE_URL, then rewrite the scheme to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# Google sign-in. The same Web client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the Next.js app.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com