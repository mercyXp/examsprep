# Windows PostgreSQL + pgAdmin: user is usually postgres.
# Password is the one you chose in the installer. If it contains @ # : / encode it in the URL.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/examsprep
SECRET_KEY=dev-only-change-me-please-use-a-long-local-secret
SEED_DEMO_USERS=true
# Browser origins allowed to call the API. 8081 is the ExamSprint web preview.
# CORS_ORIGINS=http://localhost:3000,http://localhost:8081
# One-time production super administrator on the API host. Leave unset locally.
# Set all three, redeploy, then delete them. See docs/operations/deployment.md.
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# Public site origin used in invitation and password-reset links. No trailing slash.
# FRONTEND_URL=http://localhost:3000
# APP_URL is only a fallback when FRONTEND_URL is unset.
# Resend. Leave the key unset locally to skip sending. The Staff page then shows the invitation link once.
# RESEND_API_KEY=
# EMAIL_FROM=ExamsPrep <invites@examsprep.xyz>
# Optional local folder for lesson media uploads (default: api/var/media)
# MEDIA_ROOT=var/media

# Optional lesson-studio drafts. auto uses the key when it is set, and a local draft when it is not.
# AI_PROVIDER=auto
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# Vision for Snap a Question uses the same model. Use a vision-capable model such as gpt-4o-mini.
# Shared limit for research, speech, snap, and practice calls. 0 turns the limit off.
# AI_RATE_LIMIT=12
# AI_RATE_WINDOW_SECONDS=600

# Firecrawl Research Assistant. Leave unset to show "not configured" with no invented extraction.
# FIRECRAWL_API_KEY=
# Pages per crawl on the free credit plan. JSON extract costs extra credits and falls back to markdown.
# FIRECRAWL_CRAWL_LIMIT=4

# ElevenLabs. Both are required for playback. Speech-to-text needs only the API key.
# Free tier: flash model, mp3_22050_32, and a character cap so one lesson cannot spend the month.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_MAX_CHARS=2500
# Generated audio and snap photos are stored in Postgres (bytea), not the ephemeral disk.
# AUDIO_MAX_BYTES=4000000
# SNAP_MAX_BYTES=4000000

# Render: use the provider DATABASE_URL, then rewrite the scheme to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE

# Google sign-in. The same Web client ID as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the Next.js app.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Solana (devnet). Leave the keypairs empty until you have funded them.
# The program id matches solana/keys/examsprep-program.json.
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_PROGRAM_ID=Ebo9c8SiwLx37wXejAwQmx1vLv1YtR8kYVb2Lb6V8FVH
# SOLANA_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# JSON array from `solana-keygen new -o authority.json`, or a path to that file.
# This key awards badges and pays pools. It is not the program keypair.
# SOLANA_AUTHORITY_KEYPAIR=
# Optional demo sponsor that locks USDC into a prize pool.
# SOLANA_SPONSOR_KEYPAIR=
# record = do not contact the cluster. off = refuse chain actions. Empty = live when the authority key is set.
# SOLANA_CHAIN_MODE=

# ExamSprint agent play (Byte Arena). Both stay empty until you have them.
# SPRINT_PUBLIC_BASE_URL is the public https origin of this API, no trailing slash.
# Byte refuses localhost and private IPs. See docs/byte.md.
# SPRINT_PUBLIC_BASE_URL=https://your-api.example.com
# Upload token minted at https://app.bytearena.fun/games (for devs). Do not commit it.
# BYTE_GAME_TOKEN=
# Pollar's publishable key is not read by this API. Set EXPO_PUBLIC_POLLAR_PUBLISHABLE_KEY
# in mobile-examsprint/.env. See docs/pollar.md.