# Windows PostgreSQL + pgAdmin: user is usually postgres.
# Password is the one you chose in the installer. If it contains @ # : / encode it in the URL.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5433/examsprep
SECRET_KEY=dev-only-change-me-please-use-a-long-local-secret
SEED_DEMO_USERS=true
# One-time production super administrator on the API host. Leave unset locally.
# Set all three, redeploy, then delete them. See docs/operations/deployment.md.
# SUPER_ADMIN_NAME=
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
# Public site origin used inside staff invitation links. No trailing slash.
# APP_URL=http://localhost:3000
# Leave SMTP blank to save the invitation without sending mail. The Staff page then shows the link once.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ExamsPrep <invites@your-domain.com>
# SMTP_TLS=true
# Optional local folder for lesson media uploads (default: api/var/media)
# MEDIA_ROOT=var/media

# Railway: use the provider DATABASE_URL, then rewrite the scheme to postgresql+psycopg://
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
